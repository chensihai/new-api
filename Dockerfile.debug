FROM oven/bun:1 AS web-builder

WORKDIR /build
COPY web/package.json .
COPY web/bun.lock .
RUN bun install
COPY ./web .
COPY ./VERSION .
RUN DISABLE_ESLINT_PLUGIN='true' VITE_REACT_APP_VERSION=$(cat VERSION) bun run build

FROM golang:1.26.1-alpine AS builder-debug
ENV GO111MODULE=on CGO_ENABLED=0
ENV GOOS=linux GOARCH=amd64
ENV GOEXPERIMENT=greenteagc

WORKDIR /build
ADD go.mod go.sum ./
RUN go mod download

# Install Delve
RUN go install github.com/go-delve/delve/cmd/dlv@latest

COPY . .
COPY --from=web-builder /build/dist ./web/dist

# Build with debug symbols and no optimizations
RUN go build -gcflags="all=-N -l" -ldflags "-X 'github.com/QuantumNous/new-api/common.Version=$(cat VERSION)'" -o /tmp/new-api

# Use Alpine for the final image to keep delve and go tools available
FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata wget \
    && rm -rf /var/lib/apt/lists/* \
    && update-ca-certificates

WORKDIR /build

COPY --from=builder-debug /tmp/new-api /build/new-api
COPY --from=builder-debug /go/bin/dlv /dlv

EXPOSE 3000 2345

# Delve DAP server - waits for VS Code to send a launch request
ENTRYPOINT ["/dlv", "dap", "--listen=:2345", "--log"]

